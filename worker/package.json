{
  "name": "commune-worker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "CLOUDFLARE_API_TOKEN=$(pass show cloudflare/api-key) wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply commune-events --local",
    "migrate:remote": "CLOUDFLARE_API_TOKEN=$(pass show cloudflare/api-key) wrangler d1 migrations apply commune-events --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250501.0",
    "typescript": "^5.5.3",
    "wrangler": "^4.14.0"
  }
}
